package com.example.allappsopener

import android.content.Intent
import android.content.pm.ApplicationInfo
import android.content.pm.PackageManager
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.widget.Button
import android.widget.ProgressBar
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.RecyclerView

class MainActivity : AppCompatActivity() {

        private lateinit var recyclerView: RecyclerView
            private lateinit var btnOpenAll: Button
                private lateinit var btnOpenCamera: Button
                    private lateinit var progressText: TextView
                        private lateinit var progressBar: ProgressBar

                            private val appList = mutableListOf<AppInfo>()
                                private val handler = Handler(Looper.getMainLooper())

                                    override fun onCreate(savedInstanceState: Bundle?) {
                                                super.onCreate(savedInstanceState)
                                                        setContentView(R.layout.activity_main)

                                                                recyclerView = findViewById(R.id.recyclerView)
                                                                        btnOpenAll = findViewById(R.id.btnOpenAll)
                                                                                btnOpenCamera = findViewById(R.id.btnOpenCamera)
                                                                                        progressText = findViewById(R.id.progressText)
                                                                                                progressBar = findViewById(R.id.progressBar)

                                                                                                        recyclerView.layoutManager = LinearLayoutManager(this)

                                                                                                                loadApps()

                                                                                                                        btnOpenAll.setOnClickListener {
                                                                                                                                        openAllApps()
                                                                                                                        }

                                                                                                                                btnOpenCamera.setOnClickListener {
                                                                                                                                                openCamera()
                                                                                                                                }
                                    }

                                        private fun loadApps() {
                                                    val pm = packageManager
                                                            val apps = pm.getInstalledApplications(PackageManager.GET_META_DATA)

                                                                    for (app in apps) {
                                                                                    // 只显示第三方安装的应用（排除系统应用）
                                                                                                if (app.flags and ApplicationInfo.FLAG_SYSTEM == 0) {
                                                                                                                    appList.add(
                                                                                                                                            AppInfo(
                                                                                                                                                                        appName = pm.getApplicationLabel(app).toString(),
                                                                                                                                                                                                packageName = app.packageName,
                                                                                                                                                                                                                        icon = pm.getApplicationIcon(app)
                                                                                                                                            )
                                                                                                                    )
                                                                                                }
                                                                    }

                                                                            // 按名称排序
                                                                                    appList.sortBy { it.appName.lowercase() }

                                                                                            recyclerView.adapter = AppAdapter(appList) { app ->
                                                                                                        // 点击单个应用打开
                                                                                                                    try {
                                                                                                                                        val intent = pm.getLaunchIntentForPackage(app.packageName)
                                                                                                                                                        if (intent != null) {
                                                                                                                                                                                startActivity(intent)
                                                                                                                                                        } else {
                                                                                                                                                                                Toast.makeText(this, "无法打开 ${app.appName}", Toast.LENGTH_SHORT).show()
                                                                                                                                                        }
                                                                                                                    } catch (e: Exception) {
                                                                                                                                        Toast.makeText(this, "打开失败: ${e.message}", Toast.LENGTH_SHORT).show()
                                                                                                                    }
                                                                                            }

                                                                                                    progressText.text = "共发现 ${appList.size} 个应用"
                                        }

                                            private fun openAllApps() {
                                                        if (appList.isEmpty()) {
                                                                        Toast.makeText(this, "没有找到可打开的应用", Toast.LENGTH_SHORT).show()
                                                                                    return
                                                        }

                                                                btnOpenAll.isEnabled = false
                                                                        progressBar.max = appList.size
                                                                                progressBar.progress = 0

                                                                                        progressText.text = "正在依次打开应用..."

                                                                                                // 每隔 1.5 秒打开一个应用
                                                                                                        for (i in appList.indices) {
                                                                                                                        handler.postDelayed({
                                                                                                                                            try {
                                                                                                                                                                    val intent = packageManager.getLaunchIntentForPackage(appList[i].packageName)
                                                                                                                                                                                        if (intent != null) {
                                                                                                                                                                                                                    startActivity(intent)
                                                                                                                                                                                        }
                                                                                                                                            } catch (e: Exception) {
                                                                                                                                                                    // 忽略单个失败
                                                                                                                                            }

                                                                                                                                                            progressBar.progress = i + 1
                                                                                                                                                                            progressText.text = "已打开 ${i + 1} / ${appList.size} 个应用"

                                                                                                                                                                                            // 全部打开完后，自动打开相机
                                                                                                                                                                                                            if (i == appList.size - 1) {
                                                                                                                                                                                                                                    handler.postDelayed({
                                                                                                                                                                                                                                                                openCamera()
                                                                                                                                                                                                                                                                                        btnOpenAll.isEnabled = true
                                                                                                                                                                                                                                                                                                                progressText.text = "全部完成！已打开相机"
                                                                                                                                                                                                                                    }, 1500)
                                                                                                                                                                                                            }
                                                                                                                        }, (i * 1500).toLong())
                                                                                                        }
                                            }

                                                private fun openCamera() {
                                                            try {
                                                                            // 优先打开系统相机
                                                                                        val intent = Intent("android.media.action.IMAGE_CAPTURE")
                                                                                                    if (intent.resolveActivity(packageManager) != null) {
                                                                                                                        startActivity(intent)
                                                                                                    } else {
                                                                                                                        // 尝试通过包名直接打开相机应用
                                                                                                                                        val cameraIntent = packageManager.getLaunchIntentForPackage("com.android.camera")
                                                                                                                                                        if (cameraIntent != null) {
                                                                                                                                                                                startActivity(cameraIntent)
                                                                                                                                                        } else {
                                                                                                                                                                                Toast.makeText(this, "未找到相机应用", Toast.LENGTH_SHORT).show()
                                                                                                                                                        }
                                                                                                    }
                                                            } catch (e: Exception) {
                                                                            Toast.makeText(this, "打开相机失败: ${e.message}", Toast.LENGTH_SHORT).show()
                                                            }
                                                }
}

                                                            }
                                                                                                                                                        }
                                                                                                                                                        }
                                                                                                    }
                                                                                                    }
                                                            }
                                                }
                                                                                                                                                                                                                                    })
                                                                                                                                                                                                            }
                                                                                                                                            }
                                                                                                                                                                                        }
                                                                                                                                            }
                                                                                                                        })
                                                                                                        }
                                                        }
                                            }
                                                                                                                    }
                                                                                                                                                        }
                                                                                                                                                        }
                                                                                                                    }}
                                                                                                                                            )
                                                                                                                    )
                                                                                                }
                                                                    }
                                        }
                                                                                                                                }
                                                                                                                        }
                                    }
}